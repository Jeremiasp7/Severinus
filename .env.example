# Variáveis de ambiente do Severinus.
# Copie para .env e ajuste. O arquivo .env NÃO deve ser versionado.

# --- Banco de dados -------------------------------------------------------
# Os valores abaixo batem com o docker-compose.yml e servem só para dev local.
DB_URL=jdbc:postgresql://localhost:5435/pg_severinus
DB_USER=admin
DB_PASSWORD=admin

# --- Autenticação ---------------------------------------------------------
# Segredo do JWT. Mínimo de 32 bytes (256 bits) para HMAC-SHA256.
# Gere um valor novo por ambiente e nunca reaproveite o de desenvolvimento:
#   openssl rand -base64 48
JWT_SECRET=

# --- CORS -----------------------------------------------------------------
# Origens permitidas, separadas por vírgula. Nunca use "*" em produção.
CORS_ORIGINS=http://localhost:3000

# --- Upload ---------------------------------------------------------------
# Diretório de armazenamento local dos arquivos.
UPLOAD_DIR=uploads
